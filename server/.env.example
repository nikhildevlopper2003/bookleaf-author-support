PORT=4000
NODE_ENV=development

# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# SQLite file location
DATABASE_PATH=./data/bookleaf.db

# Leave ANTHROPIC_API_KEY empty to run without AI (rule-based fallback is used)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000

# Password given to every seeded author account (demo only)
SEED_AUTHOR_PASSWORD=author123
SEED_ADMIN_PASSWORD=admin123
